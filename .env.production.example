# Production placeholder file. Copy to the deployment environment and replace every placeholder.
DATABASE_URL="postgresql://<db_user>:<db_password>@<db_host>:5432/<db_name>?schema=public"
POSTGRES_DB="<db_name>"
POSTGRES_USER="<db_user>"
POSTGRES_PASSWORD="<db_password>"
APP_ENV="production"
NODE_ENV="production"
FAI_ENVIRONMENT="production"
FAI_ENVIRONMENT_SENTINEL="FAI_CRM_PRODUCTION_V1"
COMPOSE_PROJECT_NAME="fai-crm"
APP_ENV_FILE=".env.production"
APP_IMAGE="fai-crm:pr<pr-number>-<commit-sha12>"
SOURCE_COMMIT="<full-commit-sha>"
SOURCE_TREE="<full-tree-sha>"
POSTGRES_IMAGE="postgres:16-alpine"
NEXT_PUBLIC_APP_URL="https://desk.finanzaagevolaimpresa.it"

AUTH_COOKIE_NAME="fai_crm_session"
INTERNAL_SESSION_MODE="legacy"
AUTH_SECRET="<generate-a-long-random-secret-at-least-32-bytes>"
# N03 dormant baseline: explicit disabled modes and report-only CSP.
PRIVILEGED_ACCESS_MODE="disabled"
LOGIN_THROTTLE_MODE="disabled"
LOGIN_THROTTLE_MAX_FAILURES="5"
LOGIN_THROTTLE_WINDOW_SECONDS="900"
LOGIN_THROTTLE_BLOCK_SECONDS="900"
SECURITY_HEADERS_MODE="report-only"
APP_ORIGIN="https://desk.finanzaagevolaimpresa.it"
# Leave empty until a separate key-registration and activation mandate.
PRIVILEGED_STEP_UP_KEY_VERSION=""
PRIVILEGED_STEP_UP_SECRET=""
FEATURE_INTEGRATIONS_ENABLED="false"
FEATURE_CUSTOMER_PORTAL_ENABLED="false"
FEATURE_PAYMENTS_ENABLED="false"
FEATURE_AI_WORKER_ENABLED="false"
FEATURE_AI_DISPATCH_ENABLED="false"
FEATURE_AI_EGRESS_ENABLED="false"

STORAGE_PROVIDER="local"
LOCAL_DOCUMENT_STORAGE_ROOT="/var/lib/fai-crm/documents"
DOCUMENT_MAX_BYTES="26214400"

# S3 placeholders reserved for environments where S3 support is implemented/configured.
S3_ENDPOINT="https://s3.example.com"
S3_REGION="eu-south-1"
S3_BUCKET="<private-documents-bucket>"
S3_ACCESS_KEY_ID="<s3-access-key-id>"
S3_SECRET_ACCESS_KEY="<s3-secret-access-key>"

# Compatibilità/diagnostica; i run operativi usano provider/modello del singolo agente.
AI_PROVIDER="mock"
AI_API_KEY="<server-side-ai-api-key-if-ai-provider-requires-it>"
AI_MODEL=""
# Fail-closed: abilitare solo dopo approvazione, configurazione del gate database e collaudo in staging.
AI_EXTERNAL_PROVIDERS_ENABLED="false"
# Elenco separato da virgole; vuoto = nessun modello esterno autorizzato.
AI_ALLOWED_MODELS=""
# Deve restare esattamente 0: PR82 riconosce 1 soltanto per collaudi manuali sintetici,
# ma FOUNDATION_LOCKED_V1 e canAcceptLease=false non autorizzano l'attivazione production.
# Qualsiasi valore non canonico viene rifiutato.
AI_ORCHESTRATOR_WORKER_ENABLED="0"

WEBSITE_LEAD_WEBHOOK_SECRET="<generate-a-long-random-webhook-secret>"
WEBSITE_LEAD_MODE="disabled"
WEBSITE_LEAD_RATE_LIMIT_REQUESTS="30"
WEBSITE_LEAD_RATE_LIMIT_WINDOW_SECONDS="60"
# N12 remains dormant. Key provisioning and activation require a separate mandate.
SECURE_LEAD_GATEWAY_MODE="disabled"
SECURE_LEAD_GATEWAY_KEYRING_FILE=""
