# Synthetic placeholder only. Create a separate server-side staging env file; never copy production values.
FAI_ENVIRONMENT="staging"
FAI_ENVIRONMENT_SENTINEL="FAI_CRM_STAGING_ISOLATED_V1"
COMPOSE_PROJECT_NAME="fai-crm-staging-example"
APP_ENV="staging"
NODE_ENV="production"
APP_ORIGIN="https://staging.invalid"
NEXT_PUBLIC_APP_URL="https://staging.invalid"
APP_PORT="3100"
APP_IMAGE="fai-crm:staging-<full-commit-sha>"
SOURCE_COMMIT="<full-commit-sha>"
SOURCE_TREE="<full-tree-sha>"
APP_ENV_FILE=".env.staging"
POSTGRES_DB="fai_crm_staging"
POSTGRES_USER="fai_crm_staging"
POSTGRES_PASSWORD="<staging-only-random-password>"
DATABASE_URL="postgresql://fai_crm_staging:<staging-only-random-password>@postgres:5432/fai_crm_staging?schema=public"
AUTH_COOKIE_NAME="fai_crm_staging_session"
AUTH_SECRET="<staging-only-random-secret-at-least-32-bytes>"
INTERNAL_SESSION_MODE="legacy"
PRIVILEGED_ACCESS_MODE="disabled"
LOGIN_THROTTLE_MODE="disabled"
LOGIN_THROTTLE_MAX_FAILURES="5"
LOGIN_THROTTLE_WINDOW_SECONDS="900"
LOGIN_THROTTLE_BLOCK_SECONDS="900"
SECURITY_HEADERS_MODE="report-only"
FEATURE_INTEGRATIONS_ENABLED="false"
FEATURE_CUSTOMER_PORTAL_ENABLED="false"
FEATURE_PAYMENTS_ENABLED="false"
FEATURE_AI_WORKER_ENABLED="false"
FEATURE_AI_DISPATCH_ENABLED="false"
FEATURE_AI_EGRESS_ENABLED="false"
STORAGE_PROVIDER="local"
LOCAL_DOCUMENT_STORAGE_ROOT="/var/lib/fai-crm/documents"
AI_PROVIDER="mock"
AI_EXTERNAL_PROVIDERS_ENABLED="false"
AI_ALLOWED_MODELS=""
AI_ORCHESTRATOR_WORKER_ENABLED="0"
AI_API_KEY=""
PRIVILEGED_STEP_UP_KEY_VERSION=""
PRIVILEGED_STEP_UP_SECRET=""
WEBSITE_LEAD_MODE="disabled"
WEBSITE_LEAD_WEBHOOK_SECRET=""
WEBSITE_LEAD_RATE_LIMIT_REQUESTS="30"
WEBSITE_LEAD_RATE_LIMIT_WINDOW_SECONDS="60"
# N12 remains dormant. Do not copy production key material into staging.
SECURE_LEAD_GATEWAY_MODE="disabled"
SECURE_LEAD_GATEWAY_KEYRING_FILE=""
