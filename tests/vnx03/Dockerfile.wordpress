ARG NODE_IMAGE=node:22-bookworm-slim@sha256:83f487e0a63425e5b4d146fb5e5be574bcbe1b7b843d3ebafdd95eaf7767a7e5
ARG WORDPRESS_IMAGE=wordpress:7.1-php8.4-apache@sha256:b8f37de278183840a09f5a4b5bf5ec9f09177a9984d2fe5cc072b4388128bd9d

FROM ${NODE_IMAGE} AS connector

ARG CONNECTOR_SHA256

WORKDIR /src
COPY integrations/wordpress/fai-secure-lead-connector ./integrations/wordpress/fai-secure-lead-connector
COPY tools/package-vnx02-wordpress-connector.mjs ./tools/package-vnx02-wordpress-connector.mjs

RUN mkdir -p /out \
  && node tools/package-vnx02-wordpress-connector.mjs --output /out >/tmp/package.log \
  && printf '%s  %s\n' "$CONNECTOR_SHA256" /out/fai-secure-lead-connector-1.2.1.zip \
    | sha256sum -c -

FROM ${WORDPRESS_IMAGE}

ARG WPFORMS_SHA256
ARG WPFORMS_EDITION=lite
ARG WP_CLI_SHA256

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    libcurl4-openssl-dev \
    libicu-dev \
    libonig-dev \
    openssl \
    unzip \
  && docker-php-ext-install -j"$(nproc)" curl intl mbstring \
  && rm -rf /var/lib/apt/lists/* \
  && mkdir -p /opt/vnx03

RUN --mount=type=secret,id=wpforms_pro_00 \
    --mount=type=secret,id=wpforms_pro_01 \
    --mount=type=secret,id=wpforms_pro_02 \
    --mount=type=secret,id=wpforms_pro_03 \
    --mount=type=secret,id=wpforms_pro_04 \
    --mount=type=secret,id=wpforms_pro_05 \
    --mount=type=secret,id=wpforms_pro_06 \
    --mount=type=secret,id=wpforms_pro_07 \
    --mount=type=secret,id=wpforms_pro_08 \
    --mount=type=secret,id=wpforms_pro_09 \
    --mount=type=secret,id=wpforms_pro_10 \
    --mount=type=secret,id=wpforms_pro_11 \
    --mount=type=secret,id=wpforms_pro_12 \
    --mount=type=secret,id=wpforms_pro_13 \
    --mount=type=secret,id=wpforms_pro_14 \
    --mount=type=secret,id=wpforms_pro_15 \
    --mount=type=secret,id=wpforms_pro_16 \
    --mount=type=secret,id=wpforms_pro_17 \
    --mount=type=secret,id=wpforms_pro_18 \
    --mount=type=secret,id=wpforms_pro_19 \
    --mount=type=secret,id=wpforms_pro_20 \
    --mount=type=secret,id=wpforms_pro_21 \
    --mount=type=secret,id=wpforms_pro_22 \
    --mount=type=secret,id=wpforms_pro_23 \
    --mount=type=secret,id=wpforms_pro_24 \
    --mount=type=secret,id=wpforms_pro_25 \
    --mount=type=secret,id=wpforms_pro_26 \
    --mount=type=secret,id=wpforms_pro_27 \
    --mount=type=secret,id=wpforms_pro_28 \
    --mount=type=secret,id=wpforms_pro_29 \
    --mount=type=secret,id=wpforms_pro_30 \
    --mount=type=secret,id=wpforms_pro_31 \
  case "$WPFORMS_EDITION" in \
    lite) curl --fail --silent --show-error --location \
    --proto '=https' --tlsv1.2 --retry 3 --connect-timeout 10 --max-time 180 \
    --output /opt/vnx03/wpforms.zip \
    https://downloads.wordpress.org/plugin/wpforms-lite.2.0.1.1.zip ;; \
    pro) : > /opt/vnx03/wpforms.zip; i=0; \
      while [ "$i" -lt 32 ]; do \
        part="$(printf '/run/secrets/wpforms_pro_%02d' "$i")"; \
        test -f "$part" && cat "$part" >> /opt/vnx03/wpforms.zip || exit 65; \
        i=$((i + 1)); \
      done ;; \
    *) exit 64 ;; \
  esac \
  && printf '%s  %s\n' "$WPFORMS_SHA256" /opt/vnx03/wpforms.zip | sha256sum -c -

RUN curl --fail --silent --show-error --location \
    --proto '=https' --tlsv1.2 --retry 3 --connect-timeout 10 --max-time 180 \
    --output /usr/local/bin/wp \
    https://github.com/wp-cli/wp-cli/releases/download/v2.12.0/wp-cli-2.12.0.phar

COPY --from=connector /out/fai-secure-lead-connector-1.2.1.zip /opt/vnx03/fai-secure-lead-connector.zip
COPY tests/vnx03/wordpress-config.php /opt/vnx03/wordpress-config.php
COPY tests/vnx03/setup-wordpress.php /opt/vnx03/setup-wordpress.php
COPY tests/vnx03/capture-response-mode.php /opt/vnx03/capture-response-mode.php
COPY tests/vnx03/wp-state.php /opt/vnx03/wp-state.php
COPY tests/vnx03/wordpress-entrypoint.sh /usr/local/bin/vnx03-wordpress-entrypoint.sh

RUN printf '%s  %s\n' "$WPFORMS_SHA256" /opt/vnx03/wpforms.zip | sha256sum -c - \
  && printf '%s  %s\n' "$WP_CLI_SHA256" /usr/local/bin/wp | sha256sum -c - \
  && unzip -t /opt/vnx03/wpforms.zip >/dev/null \
  && unzip -t /opt/vnx03/fai-secure-lead-connector.zip >/dev/null \
  && chmod 0644 /opt/vnx03/wpforms.zip /opt/vnx03/fai-secure-lead-connector.zip \
  && chmod 0755 /usr/local/bin/wp /usr/local/bin/vnx03-wordpress-entrypoint.sh \
  && printf '%s\n' \
    'curl.cainfo="/etc/ssl/certs/ca-certificates.crt"' \
    'openssl.cafile="/etc/ssl/certs/ca-certificates.crt"' \
    > /usr/local/etc/php/conf.d/vnx03-synthetic-ca.ini \
  && php -r 'foreach (["curl", "intl", "json", "mbstring", "mysqli", "sodium"] as $extension) { if (!extension_loaded($extension)) { fwrite(STDERR, "VNX03_PHP_EXTENSION_MISSING\n"); exit(1); } }' \
  && php /usr/local/bin/wp --info >/dev/null

ENTRYPOINT ["/usr/local/bin/vnx03-wordpress-entrypoint.sh"]
CMD ["apache2-foreground"]
