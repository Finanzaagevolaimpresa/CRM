+const queueOwner = node => {
+  if (node.type === 'brace' || node.type === 'root' || !node.parent) return node;
+
+  const seen = new Set();
+  while (node.type !== 'brace' && node.type !== 'root' && node.parent) {
+    if (seen.has(node)) {
+      throw new RangeError('AST parent chain contains a cycle');
+    }
+    seen.add(node);
+    node = node.parent;
+  }
+  return node;
+};
