# Example production Dockerfile for CRM FAI.
# Build only with exact SOURCE_COMMIT/SOURCE_TREE args and an immutable fai-crm:prN-<sha12> tag.
# Do not put secrets in this file; inject runtime values via .env.production / Docker Compose.

ARG SOURCE_COMMIT
ARG SOURCE_TREE

FROM node:22-bookworm-slim AS build

ARG SOURCE_COMMIT
ARG SOURCE_TREE

RUN printf '%s\n' "$SOURCE_COMMIT" | grep -Eq '^[0-9a-f]{40}$' \
  && printf '%s\n' "$SOURCE_TREE" | grep -Eq '^[0-9a-f]{40}$' \
  || { echo 'SOURCE_COMMIT and SOURCE_TREE must be exact 40-character Git object IDs' >&2; exit 1; }

WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
ARG SECURITY_HEADERS_MODE=report-only
ENV SECURITY_HEADERS_MODE=${SECURITY_HEADERS_MODE}

# Prisma needs OpenSSL libraries at runtime/generation time on Debian slim images.
RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
RUN npm ci

COPY prisma ./prisma
RUN npm run prisma:generate

COPY . .
RUN npm run build
RUN npm prune --omit=dev \
  && rm -rf node_modules/sharp node_modules/@img

FROM node:22-bookworm-slim AS runner

ARG SOURCE_COMMIT
ARG SOURCE_TREE

WORKDIR /app
ENV NODE_ENV=production
ENV APP_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

LABEL org.opencontainers.image.revision=${SOURCE_COMMIT} \
  it.finanzaagevolaimpresa.source-tree=${SOURCE_TREE}

RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/* \
  && groupadd --system --gid 1001 nodejs \
  && useradd --system --uid 1001 --gid nodejs nextjs \
  && mkdir -p /var/lib/fai-crm/documents \
  && chown -R nextjs:nodejs /var/lib/fai-crm

COPY --from=build --chown=nextjs:nodejs /app/package.json ./package.json
COPY --from=build --chown=nextjs:nodejs /app/package-lock.json ./package-lock.json
COPY --from=build --chown=nextjs:nodejs /app/node_modules ./node_modules
COPY --from=build --chown=nextjs:nodejs /app/prisma ./prisma
COPY --from=build --chown=nextjs:nodejs /app/scripts ./scripts
COPY --from=build --chown=nextjs:nodejs /app/src ./src
COPY --from=build --chown=nextjs:nodejs /app/public ./public
COPY --from=build --chown=nextjs:nodejs /app/.next ./.next

USER nextjs
EXPOSE 3000

CMD ["npm", "run", "start"]
