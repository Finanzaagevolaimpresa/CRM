model User {
  id                                 String                                  @id @default(cuid())
  email                              String                                  @unique
  name                               String
  passwordHash                       String
  role                               RoleCode
  active                             Boolean                                 @default(true)
  createdAt                          DateTime                                @default(now())
  updatedAt                          DateTime                                @updatedAt
  deletedAt                          DateTime?
  lastLoginAt                        DateTime?
  permissionOverrides                UserPermissionOverride[]
  internalSessions                   InternalSession[]                       @relation("InternalSessionOwner")
  sessionsRevokedByUser              InternalSession[]                       @relation("InternalSessionRevoker")
  applicationFeatureGatesUpdated     ApplicationFeatureGate[]                @relation("ApplicationFeatureGateUpdatedBy")
  applicationKeyVersionsCreated      ApplicationKeyVersion[]                 @relation("ApplicationKeyVersionCreatedBy")
  aiOrchestratorSettingsUpdated      AiOrchestratorSetting[]                 @relation("AiOrchestratorSettingUpdatedBy")
  aiWorkerCapabilitySettingsUpdated  AiOrchestratorWorkerCapabilitySetting[] @relation("AiOrchestratorWorkerCapabilitySettingUpdatedBy")
  aiOrchestratorAdminPolicyRevisions AiOrchestratorAdminPolicyRevision[]     @relation("AiOrchestratorAdminPolicyRevisionActor")
  aiWorkflowInstancesCreated         AiWorkflowInstance[]                    @relation("AiWorkflowInstanceCreatedBy")
  aiWorkflowCommandsRequested        AiWorkflowCommand[]                     @relation("AiWorkflowCommandRequestedByUser")
  aiWorkflowTransitionsPerformed     AiWorkflowTransition[]                  @relation("AiWorkflowTransitionActorUser")
  aiExecutionRequests                AiExecutionRequest[]                    @relation("AiExecutionRequestRequester")
  aiExecutionDecisions               AiExecutionDecision[]                   @relation("AiExecutionDecisionActor")
  aiExecutionGrantsApproved          AiExecutionAuthorizationGrant[]         @relation("AiExecutionGrantApprover")
  aiExecutionAdminNotifications      AiExecutionAdminNotification[]          @relation("AiExecutionNotificationRecipient")
}

model InternalSession {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String
  tokenDigest     Bytes     @unique
  createdAt       DateTime  @default(now())
  expiresAt       DateTime
  revokedAt       DateTime?
  revokedReason   String?
  revokedByUserId String?
  user            User      @relation("InternalSessionOwner", fields: [userId], references: [id], onDelete: Cascade)
  revokedByUser   User?     @relation("InternalSessionRevoker", fields: [revokedByUserId], references: [id], onDelete: SetNull)

  @@index([userId, revokedAt, expiresAt], map: "InternalSession_user_revocation_expiry_idx")
  @@index([expiresAt, id], map: "InternalSession_cleanup_cursor_idx")
}

model ApplicationFeatureGate {
  code        String   @id
  enabled     Boolean  @default(false)
  version     Int      @default(1)
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedBy   User?    @relation("ApplicationFeatureGateUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull, onUpdate: Restrict)

  @@index([enabled, code])
  @@index([updatedById])
}

model ApplicationKeyVersion {
  id          String    @id @default(uuid()) @db.Uuid
  purpose     String
  version     Int
  keyDigest   Bytes
  status      String    @default("RETIRED")
  activatedAt DateTime?
  retiredAt   DateTime?
  createdById String?
  createdAt   DateTime  @default(now())
  createdBy   User?     @relation("ApplicationKeyVersionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Restrict)

  @@unique([purpose, version])
  @@index([purpose, status])
  @@index([createdById])
}

model LoginThrottleBucket {
  keyDigest       String    @id
  failedCount     Int
  windowStartedAt DateTime
  blockedUntil    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([blockedUntil])
}

model UserPermissionOverride {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission String
  allowed    Boolean
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, permission])
  @@index([userId])
}

model Lead {
  id                 String                   @id @default(cuid())
  firstName          String
  lastName           String
  companyName        String?
  contactPerson      String?
  phone              String?
  email              String?
  source             String?
  leadSource         LeadSource               @default(manuale)
  region             String?
  province           String?
  city               String?
  interest           String?
  declaredInvestment Decimal?
  requestedAmount    Decimal?
  availableBudget    Decimal?
  status             LeadStatus               @default(nuovo)
  priority           LeadPriority             @default(media)
  commercialStatus   String?
  assignedToId       String?
  nextAction         DateTime?
  nextActionNote     String?
  nextActionDate     DateTime?
  notes              String?
  commercialProposal String?
  clientId           String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  deletedAt          DateTime?
  privacyEvidence    PrivacyEvidenceReceipt[]

  @@index([deletedAt, nextActionDate, updatedAt(sort: Desc), id(sort: Desc)], map: "Lead_pipeline_cursor_idx")
  @@index([assignedToId, deletedAt, nextActionDate, updatedAt(sort: Desc), id(sort: Desc)], map: "Lead_assignee_pipeline_cursor_idx")
}

model PrivacyNoticeVersion {
  id               String                   @id @default(uuid()) @db.Uuid
  noticeCode       String
  noticeVersion    String
  purposeCode      String
  legalBasisCode   String
  evidenceKind     PrivacyEvidenceKind
  contentHash      String
  status           PrivacyNoticeStatus      @default(DRAFT)
  effectiveFrom    DateTime?
  retiredAt        DateTime?
  createdAt        DateTime                 @default(now())
  evidenceReceipts PrivacyEvidenceReceipt[]

  @@unique([noticeCode, noticeVersion, purposeCode], map: "PrivacyNoticeVersion_identity_key")
  @@index([status, purposeCode, effectiveFrom], map: "PrivacyNoticeVersion_active_lookup_idx")
}

model PrivacyEvidenceReceipt {
  id                   String                  @id @default(uuid()) @db.Uuid
  leadId               String
  websiteLeadReceiptId String                  @db.Uuid
  noticeVersionId      String                  @db.Uuid
  catalogVersion       String
  purposeCode          String
  legalBasisCode       String
  evidenceKind         PrivacyEvidenceKind
  decision             PrivacyEvidenceDecision
  sourceSystem         String
  formCode             String
  formVersion          String
  sourceSubmittedAt    DateTime
  sourceEvidenceDigest String
  evidenceHash         String                  @unique(map: "PrivacyEvidenceReceipt_evidenceHash_key")
  createdAt            DateTime                @default(now())
  lead                 Lead                    @relation(fields: [leadId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  websiteLeadReceipt   WebsiteLeadReceipt      @relation(fields: [websiteLeadReceiptId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  noticeVersion        PrivacyNoticeVersion    @relation(fields: [noticeVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([websiteLeadReceiptId, purposeCode], map: "PrivacyEvidenceReceipt_source_purpose_key")
  @@index([leadId, createdAt], map: "PrivacyEvidenceReceipt_lead_created_idx")
  @@index([purposeCode, decision, createdAt], map: "PrivacyEvidenceReceipt_purpose_decision_idx")
  @@index([noticeVersionId, createdAt], map: "PrivacyEvidenceReceipt_notice_created_idx")
}

model CommercialOffer {
  id                    String                @id @default(cuid())
  leadId                String?
  clientId              String?
  title                 String
  description           String?
  services              String?
  includedActivities    String?
  taxableAmount         Decimal
  vatAmount             Decimal
  totalAmount           Decimal
  validUntil            DateTime?
  operationalConditions String?
  commercialProposal    String?
  status                CommercialOfferStatus @default(bozza)
  notes                 String?
  sentAt                DateTime?
  followUpAt            DateTime?
  followUpNote          String?
  outcomeNote           String?
  acceptedAt            DateTime?
  rejectedAt            DateTime?
  rejectionReason       String?
  createdById           String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  deletedAt             DateTime?
}

model Client {
  id                  String               @id @default(cuid())
  type                ClientType
  displayName         String
  leadId              String?              @unique
  status              String               @default("attivo")
  salesOwnerId        String?
  consultantId        String?
  notes               String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime?
  aiWorkflowInstances AiWorkflowInstance[]
  aiExecutionRequests AiExecutionRequest[] @relation("AiExecutionRequestClient")

  @@index([deletedAt, updatedAt(sort: Desc), id(sort: Desc)], map: "Client_active_cursor_idx")
  @@index([salesOwnerId, deletedAt, updatedAt(sort: Desc), id(sort: Desc)], map: "Client_sales_owner_cursor_idx")
  @@index([consultantId, deletedAt, updatedAt(sort: Desc), id(sort: Desc)], map: "Client_consultant_cursor_idx")
}

model Company {
