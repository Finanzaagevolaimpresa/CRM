model Task {
  id              String       @id @default(cuid())
  clientId        String?
  companyId       String?
  projectId       String?
  clientServiceId String?
  title           String
  description     String?
  type            String?
  priority        TaskPriority @default(media)
  status          TaskStatus   @default(aperta)
