model Deadline {
  id         String   @id @default(cuid())
  title      String
  entityType String
  entityId   String
  dueAt      DateTime
  status     String   @default("aperta")
}

model AiAgent {
  id                    String                 @id @default(cuid())
  code                  String                 @unique
  name                  String
  description           String                 @default("")
  operationalScope      String                 @default("")
  systemPrompt          String                 @default("")
  requiredDataChecklist Json                   @default("[]")
  expectedOutput        String                 @default("")
  toneStyle             String                 @default("")
  active                Boolean                @default(true)
  provider              String                 @default("mock")
  futureModel           String?
  promptVersion         String
  configVersion         Int                    @default(1)
  inputSchema           Json
  outputSchema          Json
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  configVersions        AiAgentConfigVersion[]
}

model AiControlSetting {
  id                            String   @id @default("global")
  externalProvidersEnabled      Boolean  @default(false)
  maxExternalRunsPerUserPerHour Int      @default(10)
  updatedById                   String?
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt
}

model AiOrchestratorSetting {
  id                  String   @id @default("global")
  stateMachineEnabled Boolean  @default(false)
  dispatchEnabled     Boolean  @default(false)
  syntheticDataOnly   Boolean  @default(true)
  provider            String   @default("mock")
  version             Int      @default(1)
  updatedById         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  updatedBy           User?    @relation("AiOrchestratorSettingUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([updatedById])
}

model AiOrchestratorWorkerCapabilitySetting {
  jobCode           String   @id
  capabilityCode    String   @unique
  capabilityVersion String
  capabilityHash    String   @unique
  enabled           Boolean  @default(false)
  version           Int      @default(1)
  updatedById       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  updatedBy         User?    @relation("AiOrchestratorWorkerCapabilitySettingUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([enabled, jobCode])
  @@index([updatedById])
}

model AiOrchestratorAdminPolicyRevision {
  id                   String   @id
  scopeType            String
  scopeCode            String
  targetDefinitionHash String
  version              Int
  policy               Json
  policyHash           String
  previousRevisionHash String?
  revisionHash         String   @unique(map: "AiOAdminPolicy_revisionHash_key")
  requestId            String?  @unique(map: "AiOAdminPolicy_requestId_key")
  requestHash          String
  requestedPolicyHash  String
  expectedVersion      Int?
  expectedRevisionHash String?
  operationCode        String
  requiredPermissions  Json
  permissionDecisions  Json
  actorUserId          String?
  actorRole            String?
  reasonCode           String
  reason               String
  confirmed            Boolean
  createdAt            DateTime @default(now())
  actorUser            User?    @relation("AiOrchestratorAdminPolicyRevisionActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "AiOAdminPolicy_actor_fkey")

  @@unique([scopeType, scopeCode, version], map: "AiOAdminPolicy_scope_version_key")
  @@unique([scopeType, scopeCode, previousRevisionHash], map: "AiOAdminPolicy_scope_previous_key")
  @@index([scopeType, scopeCode, version], map: "AiOAdminPolicy_scope_latest_idx")
  @@index([scopeType, scopeCode, createdAt], map: "AiOAdminPolicy_scope_audit_idx")
  @@index([actorUserId, createdAt], map: "AiOAdminPolicy_actor_audit_idx")
  @@index([operationCode, createdAt], map: "AiOAdminPolicy_operation_audit_idx")
  @@index([requestHash], map: "AiOAdminPolicy_requestHash_idx")
  @@index([createdAt, id], map: "AiOAdminPolicy_audit_cursor_idx")
}

model AiWorkflowInstance {
  id                  String                      @id @default(cuid())
  creationKey         String                      @unique
  creationRequestHash String
  workflowCode        String
  workflowVersion     String
  definitionHash      String
  dataMode            String                      @default("synthetic")
  clientId            String?
  companyId           String?
  projectId           String?
  clientServiceId     String?
  currentState        String                      @default("CREATED")
  stateVersion        Int                         @default(1)
  correctionCycle     Int                         @default(0)
  lastTransitionAt    DateTime?
  createdById         String
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  client              Client?                     @relation(fields: [clientId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  company             Company?                    @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  project             Project?                    @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  clientService       ClientService?              @relation(fields: [clientServiceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy           User                        @relation("AiWorkflowInstanceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  commands            AiWorkflowCommand[]
  transitions         AiWorkflowTransition[]
  jobs                AiWorkflowJob[]
  jobOutboxEvents     AiWorkflowJobOutboxEvent[]
  jobRuntimes         AiWorkflowJobRuntime[]
  jobRuntimeEvents    AiWorkflowJobRuntimeEvent[]
  jobResults          AiWorkflowJobResult[]

  @@index([workflowCode, workflowVersion])
  @@index([currentState, updatedAt])
  @@index([clientId])
  @@index([companyId])
  @@index([projectId])
  @@index([clientServiceId])
  @@index([createdById])
}

model AiWorkflowCommand {
  id                            String                @id @default(cuid())
  workflowInstanceId            String
  transitionCode                String
  eventType                     String
  idempotencyKey                String
  requestHash                   String
  definitionHash                String
  expectedState                 String
  expectedStateVersion          Int
  actorKind                     String
  requestedByUserId             String?
  requestedByAgentId            String?
  requestedByAgentConfigVersion Int?
  requestedBySystemCode         String?
  correlationId                 String
  status                        String                @default("PENDING")
  resultState                   String?
  resultStateVersion            Int?
  rejectionCode                 String?
  resolvedAt                    DateTime?
  createdAt                     DateTime              @default(now())
  updatedAt                     DateTime              @updatedAt
  workflowInstance              AiWorkflowInstance    @relation(fields: [workflowInstanceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  requestedByUser               User?                 @relation("AiWorkflowCommandRequestedByUser", fields: [requestedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  requestedByAgentConfig        AiAgentConfigVersion? @relation("AiWorkflowCommandRequestedByAgentConfig", fields: [requestedByAgentId, requestedByAgentConfigVersion], references: [agentId, version], onDelete: Restrict, onUpdate: Restrict)
  transition                    AiWorkflowTransition?

  @@unique([id, workflowInstanceId])
  @@unique([workflowInstanceId, idempotencyKey])
  @@index([workflowInstanceId, status, createdAt])
  @@index([requestedByUserId])
  @@index([requestedByAgentId, requestedByAgentConfigVersion], map: "AiWorkflowCommand_agentConfig_idx")
  @@index([correlationId])
}

model AiWorkflowTransition {
  id                      String                     @id @default(cuid())
  workflowInstanceId      String
  commandId               String                     @unique
  transitionCode          String
  eventType               String
  sequence                Int
  fromState               String
  toState                 String
  fromVersion             Int
  toVersion               Int
  definitionHash          String
  guardSnapshot           Json
  guardSnapshotHash       String
  previousTransitionHash  String?
  transitionHash          String                     @unique
  actorKind               String
  actorUserId             String?
  actorAgentId            String?
  actorAgentConfigVersion Int?
  actorSystemCode         String?
  reasonCode              String?
  correlationId           String
  metadata                Json
  jobPlanningVersion      Int?
  createdAt               DateTime                   @default(now())
  workflowInstance        AiWorkflowInstance         @relation(fields: [workflowInstanceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  command                 AiWorkflowCommand          @relation(fields: [commandId, workflowInstanceId], references: [id, workflowInstanceId], onDelete: Restrict, onUpdate: Restrict)
  actorUser               User?                      @relation("AiWorkflowTransitionActorUser", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actorAgentConfig        AiAgentConfigVersion?      @relation("AiWorkflowTransitionActorAgentConfig", fields: [actorAgentId, actorAgentConfigVersion], references: [agentId, version], onDelete: Restrict, onUpdate: Restrict)
  previousTransition      AiWorkflowTransition?      @relation("AiWorkflowTransitionHashChain", fields: [workflowInstanceId, previousTransitionHash], references: [workflowInstanceId, transitionHash], onDelete: NoAction, onUpdate: NoAction)
  nextTransitions         AiWorkflowTransition[]     @relation("AiWorkflowTransitionHashChain")
  plannedJobs             AiWorkflowJob[]
  jobOutboxEvents         AiWorkflowJobOutboxEvent[]

  @@unique([commandId, workflowInstanceId])
  @@unique([workflowInstanceId, sequence])
  @@unique([workflowInstanceId, transitionHash])
  @@index([workflowInstanceId, createdAt])
  @@index([transitionCode, createdAt])
  @@index([actorUserId])
  @@index([actorAgentId, actorAgentConfigVersion], map: "AiWorkflowTransition_agentConfig_idx")
  @@index([correlationId])
}

model AiWorkflowJob {
  id                         String                        @id @default(cuid())
  workflowInstanceId         String
  sourceTransitionId         String
  sourceTransitionCode       String
  sourceTransitionSequence   Int
  workflowDefinitionHash     String
  phaseCode                  String
  phaseEntrySequence         Int
  sourceState                String
  sourceStateVersion         Int
  correctionCycle            Int
  executorAgentId            String
  executorAgentCode          String
  executorAgentConfigVersion Int
  executorAgentConfigHash    String
  catalogCode                String
  catalogVersion             String
  catalogHash                String
  jobCode                    String
  jobVersion                 String
  jobDefinitionHash          String
  completionTransitionCode   String
  completionMode             String
  slotKey                    String
  bundleCode                 String
  bundleKey                  String
  dedupeKey                  String                        @unique
  status                     String                        @default("PLANNED")
  provider                   String                        @default("mock")
  dataMode                   String                        @default("synthetic")
  automaticDispatchAllowed   Boolean                       @default(false)
  payload                    Json
  payloadHash                String
  correlationId              String
  plannedAt                  DateTime                      @default(now())
  availableAt                DateTime
  blockedAt                  DateTime?
  blockedReasonCode          String?
  workflowInstance           AiWorkflowInstance            @relation(fields: [workflowInstanceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sourceTransition           AiWorkflowTransition          @relation(fields: [sourceTransitionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  executorAgentConfig        AiAgentConfigVersion          @relation("AiWorkflowJobExecutorConfig", fields: [executorAgentId, executorAgentConfigVersion], references: [agentId, version], onDelete: Restrict, onUpdate: Restrict)
  outboxEvents               AiWorkflowJobOutboxEvent[]
  runtime                    AiWorkflowJobRuntime?
  runtimeAttempts            AiWorkflowJobAttempt[]
  results                    AiWorkflowJobResult[]
  outboxConsumptions         AiWorkflowOutboxConsumption[]
  runtimeEvents              AiWorkflowJobRuntimeEvent[]

  @@unique([sourceTransitionId, jobCode, jobVersion, slotKey])
  @@index([status, availableAt])
  @@index([workflowInstanceId, status, availableAt])
  @@index([phaseCode, correctionCycle, status])
  @@index([executorAgentId, executorAgentConfigVersion, status], map: "AiWorkflowJob_executorConfig_status_idx")
  @@index([sourceTransitionId])
  @@index([bundleKey, status])
  @@index([correlationId])
}

model AiWorkflowJobOutboxEvent {
  id                 String                       @id @default(cuid())
  jobId              String
  workflowInstanceId String
  sourceTransitionId String
  eventKey           String                       @unique
  eventType          String
  eventVersion       Int                          @default(1)
  payload            Json
  payloadHash        String
  deliveryState      String                       @default("PENDING")
  occurredAt         DateTime                     @default(now())
  job                AiWorkflowJob                @relation(fields: [jobId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  workflowInstance   AiWorkflowInstance           @relation(fields: [workflowInstanceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sourceTransition   AiWorkflowTransition         @relation(fields: [sourceTransitionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  consumption        AiWorkflowOutboxConsumption?

  @@unique([jobId, eventType])
  @@index([deliveryState, occurredAt])
  @@index([workflowInstanceId, occurredAt])
  @@index([sourceTransitionId])
}

model AiWorkflowJobRuntime {
  id                   String                       @id @default(cuid())
  jobId                String                       @unique
  workflowInstanceId   String
  runtimePolicyCode    String
  runtimePolicyVersion String
  runtimePolicyHash    String
  capabilityCode       String
  capabilityVersion    String
  capabilityHash       String
  handlerCode          String
  handlerVersion       String
  state                String                       @default("AVAILABLE")
  effectiveAvailableAt DateTime
  attemptSequence      Int                          @default(0)
  retryFailureCount    Int                          @default(0)
  fencingToken         BigInt                       @default(0)
  leaseOwnerId         String?
  leaseTokenHash       String?
  leaseClaimedAt       DateTime?
  leaseExpiresAt       DateTime?
  leaseMaxExpiresAt    DateTime?
  terminalAt           DateTime?
  terminalReasonCode   String?
  resultHash           String?
  lastFailureCode      String?
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  job                  AiWorkflowJob                @relation(fields: [jobId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  workflowInstance     AiWorkflowInstance           @relation(fields: [workflowInstanceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  attempts             AiWorkflowJobAttempt[]
  results              AiWorkflowJobResult[]
  outboxConsumption    AiWorkflowOutboxConsumption?
  events               AiWorkflowJobRuntimeEvent[]

  @@index([state, effectiveAvailableAt])
  @@index([state, leaseExpiresAt])
  @@index([workflowInstanceId, state, effectiveAvailableAt])
}

model AiWorkflowJobAttempt {
  id                         String               @id @default(cuid())
  runtimeId                  String
  jobId                      String
  attemptSequence            Int
  fencingToken               BigInt
  workerInstanceId           String
  workerBuildHash            String
  leaseTokenHash             String
  claimedAt                  DateTime
  leaseExpiresAt             DateTime
  leaseMaxExpiresAt          DateTime
  finishedAt                 DateTime?
  outcome                    String?
  failureCode                String?
  retryable                  Boolean?
  retryBudgetConsumed        Boolean?
  nextAvailableAt            DateTime?
  resultHash                 String?
  runtimePolicyHash          String
  capabilityHash             String
  handlerCode                String
  handlerVersion             String
  workflowDefinitionHash     String
  phaseCode                  String
  phaseEntrySequence         Int
  correctionCycle            Int
  executorAgentId            String
  executorAgentConfigVersion Int
  executorAgentConfigHash    String
  jobPayloadHash             String
  createdAt                  DateTime             @default(now())
  runtime                    AiWorkflowJobRuntime @relation(fields: [runtimeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  job                        AiWorkflowJob        @relation(fields: [jobId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  result                     AiWorkflowJobResult?

  @@unique([runtimeId, attemptSequence])
  @@unique([runtimeId, fencingToken])
  @@index([jobId, attemptSequence])
  @@index([outcome, finishedAt])
  @@index([leaseExpiresAt])
}

model AiWorkflowJobResult {
  id                         String                        @id @default(cuid())
  runtimeId                  String
  jobId                      String
  attemptId                  String                        @unique
  attemptSequence            Int
  fencingToken               BigInt
  workerInstanceId           String
  workerBuildHash            String
  runtimePolicyHash          String
  capabilityCode             String
  capabilityVersion          String
  capabilityHash             String
  handlerCode                String
  handlerVersion             String
  resultContractCode         String
  resultContractVersion      String
  resultContractHash         String
  jobPayloadHash             String
  workflowInstanceId         String
  workflowDefinitionHash     String
  phaseCode                  String
  phaseEntrySequence         Int
  correctionCycle            Int
  executorAgentId            String
  executorAgentCode          String
  executorAgentConfigVersion Int
  executorAgentConfigHash    String
  provider                   String                        @default("mock")
  dataMode                   String                        @default("synthetic")
  payload                    Json
  payloadHash                String
  manifestHash               String
  resultHash                 String                        @unique
  artifactCount              Int
  totalPayloadBytes          Int
  retentionPolicyCode        String
  retentionPolicyVersion     String
  retentionPolicyHash        String
  retentionClass             String
  retainUntil                DateTime?
  createdAt                  DateTime                      @default(now())
  runtime                    AiWorkflowJobRuntime          @relation(fields: [runtimeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  job                        AiWorkflowJob                 @relation(fields: [jobId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  attempt                    AiWorkflowJobAttempt          @relation(fields: [attemptId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  workflowInstance           AiWorkflowInstance            @relation(fields: [workflowInstanceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  artifacts                  AiWorkflowJobArtifact[]
  sourceReferences           AiWorkflowJobSourceArtifact[]

  @@unique([runtimeId, jobId, attemptSequence])
  @@index([runtimeId, resultHash])
  @@index([jobId, createdAt])
  @@index([workflowInstanceId, createdAt])
}

model AiWorkflowJobArtifact {
  id                    String                        @id @default(cuid())
  resultId              String
  ordinal               Int
  slotCode              String
  logicalKey            String
  artifactType          String
  artifactSchemaCode    String
  artifactSchemaVersion String
  artifactSchemaHash    String
  artifactVersion       String
  mediaType             String                        @default("application/json")
  payload               Json
  payloadHash           String
  artifactHash          String
  payloadBytes          Int
  supersedesArtifactId  String?
  createdAt             DateTime                      @default(now())
  result                AiWorkflowJobResult           @relation(fields: [resultId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  supersedesArtifact    AiWorkflowJobArtifact?        @relation("AiWorkflowArtifactSupersession", fields: [supersedesArtifactId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  supersededByArtifacts AiWorkflowJobArtifact[]       @relation("AiWorkflowArtifactSupersession")
  sourceUsages          AiWorkflowJobSourceArtifact[] @relation("AiWorkflowSourceArtifact")

  @@unique([resultId, ordinal])
  @@unique([resultId, slotCode])
  @@unique([resultId, logicalKey])
  @@index([resultId])
  @@index([artifactHash])
  @@index([artifactType, artifactHash])
}

model AiWorkflowJobSourceArtifact {
  id                 String                @id @default(cuid())
  resultId           String
  sourceArtifactId   String
  sourceArtifactHash String
  role               String
  ordinal            Int
  createdAt          DateTime              @default(now())
  result             AiWorkflowJobResult   @relation(fields: [resultId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sourceArtifact     AiWorkflowJobArtifact @relation("AiWorkflowSourceArtifact", fields: [sourceArtifactId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([resultId, ordinal])
  @@unique([resultId, sourceArtifactId])
  @@index([sourceArtifactId])
}

model AiWorkflowOutboxConsumption {
  id                         String                   @id @default(cuid())
  outboxEventId              String                   @unique
  jobId                      String
  runtimeId                  String                   @unique
  consumerCode               String
  consumerVersion            String
  runtimePolicyHash          String
  capabilityHash             String
  eventKey                   String
  eventPayloadHash           String
  jobDedupeKey               String
  jobPayloadHash             String
  workflowDefinitionHash     String
  phaseCode                  String
  phaseEntrySequence         Int
  correctionCycle            Int
  executorAgentId            String
  executorAgentConfigVersion Int
  executorAgentConfigHash    String
  consumedAt                 DateTime                 @default(now())
  outboxEvent                AiWorkflowJobOutboxEvent @relation(fields: [outboxEventId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  job                        AiWorkflowJob            @relation(fields: [jobId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  runtime                    AiWorkflowJobRuntime     @relation(fields: [runtimeId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([jobId])
  @@index([consumerCode, consumerVersion, consumedAt])
  @@index([consumedAt])
}

model AiWorkflowJobRuntimeEvent {
  id                 String               @id @default(cuid())
  runtimeId          String
  jobId              String
  workflowInstanceId String
  sequence           Int
  eventType          String
  attemptSequence    Int?
  fencingToken       BigInt?
  reasonCode         String?
  payload            Json
  payloadHash        String
  previousEventHash  String?
  eventHash          String               @unique
  occurredAt         DateTime             @default(now())
  runtime            AiWorkflowJobRuntime @relation(fields: [runtimeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  job                AiWorkflowJob        @relation(fields: [jobId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  workflowInstance   AiWorkflowInstance   @relation(fields: [workflowInstanceId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([runtimeId, sequence])
  @@unique([runtimeId, eventHash])
  @@index([jobId, occurredAt])
  @@index([workflowInstanceId, occurredAt])
  @@index([eventType, occurredAt])
}

model AiAgentConfigVersion {
  id                    String                          @id @default(cuid())
  agentId               String
  version               Int
  code                  String
  name                  String
  description           String
  operationalScope      String
  systemPrompt          String
  requiredDataChecklist Json
  expectedOutput        String
  toneStyle             String
  active                Boolean
  provider              String
  model                 String?
  promptVersion         String
  inputSchema           Json
  outputSchema          Json
  createdById           String?
  createdAt             DateTime                        @default(now())
  agent                 AiAgent                         @relation(fields: [agentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  runs                  AiRun[]                         @relation("AiRunAgentConfigVersion")
  workflowCommands      AiWorkflowCommand[]             @relation("AiWorkflowCommandRequestedByAgentConfig")
  workflowTransitions   AiWorkflowTransition[]          @relation("AiWorkflowTransitionActorAgentConfig")
  executorJobs          AiWorkflowJob[]                 @relation("AiWorkflowJobExecutorConfig")
  executionRequests     AiExecutionRequest[]            @relation("AiExecutionRequestAgentConfig")
  executionGrants       AiExecutionAuthorizationGrant[] @relation("AiExecutionGrantAgentConfig")

  @@unique([agentId, version])
  @@index([agentId, createdAt])
}

model AiRun {
  id                          String                         @id @default(cuid())
  reliabilityVersion          Int?
  agentId                     String
  agentConfigVersion          Int?
  clientId                    String?
  clientServiceId             String?
  projectId                   String?
  status                      String                         @default("completed")
  provider                    String                         @default("unknown")
  model                       String?
  promptVersion               String?
  requestKey                  String?
  requestFingerprint          String?
  executionInputHash          String?
  hashCanonicalizationVersion Int?
  leaseExpiresAt              DateTime?
  leaseTokenHash              String?
  egressPermitHash            String?
  egressStartedAt             DateTime?
  externalPayloadHash         String?
  finishedAt                  DateTime?
  failureCode                 String?
  externalConfirmedAt         DateTime?
  externalDataCategories      Json?
  inputTokens                 Int?
  outputTokens                Int?
  totalTokens                 Int?
  providerRequestId           String?
  input                       Json?
  output                      Json?
  operationalInstructions     String?
  createdById                 String?
  aiExecutionRequestId        String?
  authorizationGrantId        String?                        @unique(map: "AiRun_authorizationGrantId_key")
  createdAt                   DateTime                       @default(now())
  agentConfig                 AiAgentConfigVersion?          @relation("AiRunAgentConfigVersion", fields: [agentId, agentConfigVersion], references: [agentId, version], onDelete: Restrict, onUpdate: Restrict)
  aiExecutionRequest          AiExecutionRequest?            @relation(fields: [aiExecutionRequestId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "AiRun_aiExecutionRequestId_fkey")
  authorizationGrant          AiExecutionAuthorizationGrant? @relation(fields: [authorizationGrantId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "AiRun_authorizationGrantId_fkey")

  @@unique([createdById, requestKey])
  @@index([agentId, agentConfigVersion])
  @@index([status, leaseExpiresAt])
  @@index([clientId])
  @@index([clientServiceId])
  @@index([projectId])
  @@index([aiExecutionRequestId])
  @@index([createdAt(sort: Desc), id(sort: Desc)], map: "AiRun_created_cursor_idx")
}

model AiExecutionRequest {
  id                          String                         @id @default(cuid())
  origin                      AiExecutionRequestOrigin
  requesterKind               AiExecutionRequesterKind
  requesterUserId             String?
  requesterIdentity           String?
  clientId                    String?
  companyId                   String?
  projectId                   String?
  clientServiceId             String?
  functionCode                String
  agentId                     String
  agentConfigVersion          Int
  provider                    String
  model                       String?
  purposeCode                 String
  dataCategories              Json
  correlationId               String
  idempotencyKey              String
  inputFingerprint            String
  executionInputHash          String
  hashCanonicalizationVersion Int                            @default(1)
  supersedesRequestId         String?                        @unique(map: "AiExecRequest_supersedes_key")
  expiresAt                   DateTime
  status                      AiExecutionRequestStatus       @default(PENDING_ADMIN_APPROVAL)
  stateVersion                Int                            @default(1)
  createdAt                   DateTime                       @default(now())
  updatedAt                   DateTime                       @updatedAt
  requester                   User?                          @relation("AiExecutionRequestRequester", fields: [requesterUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "AiExecRequest_requester_fkey")
  client                      Client?                        @relation("AiExecutionRequestClient", fields: [clientId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "AiExecRequest_client_fkey")
  company                     Company?                       @relation("AiExecutionRequestCompany", fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "AiExecRequest_company_fkey")
  project                     Project?                       @relation("AiExecutionRequestProject", fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "AiExecRequest_project_fkey")
  clientService               ClientService?                 @relation("AiExecutionRequestClientService", fields: [clientServiceId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "AiExecRequest_service_fkey")
  agentConfig                 AiAgentConfigVersion           @relation("AiExecutionRequestAgentConfig", fields: [agentId, agentConfigVersion], references: [agentId, version], onDelete: Restrict, onUpdate: Restrict, map: "AiExecRequest_agentConfig_fkey")
  decisions                   AiExecutionDecision[]
  authorizationGrant          AiExecutionAuthorizationGrant?
  adminNotifications          AiExecutionAdminNotification[]
  runs                        AiRun[]
  supersedesRequest           AiExecutionRequest?            @relation("AiExecutionRequestSupersession", fields: [supersedesRequestId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "AiExecRequest_supersedes_fkey")
  supersededBy                AiExecutionRequest?            @relation("AiExecutionRequestSupersession")

  @@unique([origin, idempotencyKey], map: "AiExecRequest_origin_idempotency_key")
  @@index([status, expiresAt], map: "AiExecRequest_status_expiry_idx")
  @@index([requesterUserId, createdAt], map: "AiExecRequest_requester_idx")
  @@index([clientId, createdAt], map: "AiExecRequest_client_idx")
  @@index([companyId, createdAt], map: "AiExecRequest_company_idx")
  @@index([projectId, createdAt], map: "AiExecRequest_project_idx")
  @@index([clientServiceId, createdAt], map: "AiExecRequest_service_idx")
  @@index([correlationId], map: "AiExecRequest_correlation_idx")
  @@index([agentId, agentConfigVersion], map: "AiExecRequest_agentConfig_idx")
}

