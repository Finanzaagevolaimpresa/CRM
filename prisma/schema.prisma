  @@index([clientId])
  @@index([clientServiceId])
  @@index([projectId])
  @@index([assignedToId])
  @@index([dueAt])
  @@index([deletedAt, dueAt, updatedAt(sort: Desc), id(sort: Desc)], map: "Task_active_due_cursor_idx")
  @@index([assignedToId, deletedAt, dueAt, id(sort: Desc)], map: "Task_assignee_due_cursor_idx")
